% ##############################################################################
% math-shorthandz.sty — smart shorthands for typesetting math in LaTeX
%
% Provides:
%   \zpunct   punctuation before equation number
%   \zline    arbitrary underline stacking (\zvec, \zmat convenience wrappers)
%   \zfrac    flexible fraction with configurable style and parenthesisation
%   \zscale   uniform scaling of math content
%   \zdot     math-mode dot product symbol with configurable size and placement
%   \zarg     scaled parenthesised function argument
%   \zdiff    differential and derivative operator
%   \zcond    "evaluated at" vertical bar with condition
%   \zscript  pre- and post-scripts with optional scaling
%   \zprime   prime superscript or accent, context-sensitive scaling
%   \zlim     limit operator with variable and value, below or as a subscript
%   \zint     configurable integral with glyph type and limit placement
%   \zalias   variants of the commands above with their own option values
%
% Dependencies:
%   amsmath, unicode-math, graphicx, nicefrac, xkeyval
%   (expl3 and xparse are part of the LaTeX kernel since 2020)
%
% Structure:
%   One section per public command, ordered from the commands that depend on
%   nothing to those that build on the others. Each section keeps the same
%   order: options, constants, helpers, public command. The manual
%   (math-shorthandz.tex) is the reference for behaviour; the comments here
%   only give syntax and implementation notes.
%
%   Every option is a \msz@... macro read at call time, so it may be set with
%   \usepackage[...] or \setkeys{shorthand}{...}, globally or inside a group.
%   Key names carry the full command name (zint-, zdiff-, ...); macro names
%   drop the leading "z" (\msz@int@..., initials of math-shorthandz).
%
% Copyright (C) 2020-2026 Tiago Pomella Lobo
%
% This work may be distributed and/or modified under the conditions of the
% LaTeX Project Public License, either version 1.3c of this license or (at
% your option) any later version. The latest version of this license is in
%   https://www.latex-project.org/lppl.txt
% and version 1.3c or later is part of all distributions of LaTeX version
% 2008 or later.
%
% This work has the LPPL maintenance status `author-maintained'.
%
% The Current Maintainer of this work is Tiago Pomella Lobo
% (https://github.com/tplobo/math-shorthandz).
%
% This work consists of the files math-shorthandz.sty, math-shorthandz.tex,
% math-shorthandz-listings.tex and README.md, and the derived file
% math-shorthandz.pdf.
% ##############################################################################

\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{math-shorthandz}[2026/10/23 v1.1.0 smart shorthands for typesetting math]

% ------------------------------------------------------------------------------
% Required packages
% ------------------------------------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\RequirePackage{nicefrac}
\RequirePackage{xkeyval}

% ------------------------------------------------------------------------------
% Configure packages
% ------------------------------------------------------------------------------

% The integral glyphs are prescribed so that \intop and \ointop render with
% XITS glyphs. The base math font is left to the user; recommended:
%   \setmathfont{TeX Gyre DejaVu Math}[Scale=0.85]
\AtBeginDocument{\setmathfont[range={"222B-"2233}]{XITS Math}}

\makeatletter

% ==============================================================================
% GLOBAL
% ------------------------------------------------------------------------------
% Shared by several commands:
%   \msz@opt       declares an option macro and its key, and registers the
%                  macro in its family (for \zalias snapshots and resets)
%   \__msz_begin:  opens every call of a command with options; applies the
%                  keys of the alias that called it (see \zalias)
%   units          ratios of a style's x-height (v, above, below) and quad
%                  (h, before, after); the axis height is also measured
%   scales         four factors per math style plus `<command>-scale-absolute`
%                  per command (true: set in normal size, then multiplied;
%                  false: set in the ambient style, then multiplied)
%   nesting guard  \l__msz_scale_acc_fp is the scale of the enclosing scaled
%                  boxes; a nested call is shrunk by it only down to the size
%                  of a scriptscript call of the same command
% ==============================================================================

  % \msz@opt {family} {key suffix} {macro suffix} {default} — declares the
  % option macro \msz@<family>@<macro suffix> and its key z<family>-<key
  % suffix>; the first call of a family also declares z<family>-reset. Key
  % names are also collected in \msz@keysfull and \msz@keys (used by the manual).
  \def\msz@keysfull{}
  \def\msz@keys{}
  \newcommand{\msz@opt}[4]{%
    \@ifundefined{msz@reg@#1}{%
      \expandafter\gdef\csname msz@reg@#1\endcsname{}%
      \define@key{shorthand}{z#1-reset}[]{\msz@reset{#1}}%
    }{}%
    \expandafter\newcommand\csname msz@#1@#3\endcsname{#4}%
    \define@key{shorthand}{z#1-#2}{\msz@opt@set{#1}{#3}{##1}}%
    \expandafter\g@addto@macro\csname msz@reg@#1\endcsname{\msz@reg@do{#1}{#3}}%
    \g@addto@macro\msz@keysfull{z#1-#2,}%
    \g@addto@macro\msz@keys{#2,}%
  }

\ExplSyntaxOn

  \dim_new:N \l__msz_unit_h_dim
  \dim_new:N \l__msz_unit_v_dim
  \dim_new:N \l__msz_unit_axis_dim
  \box_new:N \l__msz_unit_box

  % keys and family of the alias being called, waiting for its command
  \tl_new:N  \g__msz_alias_tl
  \tl_new:N  \g__msz_alias_fam_tl

  \msg_new:nnn { math-shorthandz } { reset-misuse }
    {
      \c_backslash_str zreset~is~only~valid~as~the~value~of~a~key~in~
      \c_backslash_str zalias.
    }
  \msg_new:nnn { math-shorthandz } { reset-outside }
    {
      Option~reset~(key~reset~or~value~\c_backslash_str zreset)~is~only~
      available~in~the~keys~of~\c_backslash_str zalias.
    }

  % protected marker: as the value of a key, restores the option from the
  % snapshot of the alias call (see \msz@opt@set)
  \cs_new_protected:Npn \zreset
    { \msg_error:nn { math-shorthandz } { reset-misuse } }

  % sets the units (horizontal quad, vertical x-height, axis height) for style #1
  \cs_new_protected:Npn \__msz_unit:N #1
    {
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 x $ }
      \dim_set:Nn \l__msz_unit_v_dim { \box_ht:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 \mkern 18mu $ }
      \dim_set:Nn \l__msz_unit_h_dim { \box_wd:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #1 \vcenter { \hbox { } } $ }
      \dim_set:Nn \l__msz_unit_axis_dim { \box_ht:N \l__msz_unit_box }
    }

  % expands to the length (ratio #1) * (unit dimension #2)
  \cs_new:Npn \__msz_ratio:nN #1#2
    { \fp_to_dim:n { (#1) * #2 } }

  % registry actions, run over the options of a family by its list
  % \msz@reg@<family>: \msz@reg@do is \let to one of them just before the list
  % is expanded. Arguments: #1 family, #2 macro suffix.
  \cs_new_protected:Npn \msz@reg@do #1#2 { }
  \cs_new_protected:Npn \msz@snap@do #1#2
    { \cs_set_eq:cc { msz@snap@ #1 @ #2 } { msz@ #1 @ #2 } }
  \cs_new_protected:Npn \msz@rest@do #1#2
    { \cs_set_eq:cc { msz@ #1 @ #2 } { msz@snap@ #1 @ #2 } }

  % copies every option of family #1 to its snapshot, in the current group,
  % and marks the family as snapshotted
  \cs_new_protected:Npn \__msz_snap:n #1
    {
      \cs_set:cpn { msz@snap@ #1 @flag } { }
      \cs_set_eq:NN \msz@reg@do \msz@snap@do
      \use:c { msz@reg@ #1 }
    }

  % key z<family>-reset: restores all options of family #1 from the snapshot
  \cs_new_protected:Npn \msz@reset #1
    {
      \cs_if_exist:cTF { msz@snap@ #1 @flag }
        {
          \cs_set_eq:NN \msz@reg@do \msz@rest@do
          \use:c { msz@reg@ #1 }
        }
        { \msg_error:nnn { math-shorthandz } { reset-outside } { #1 } }
    }

  % restores option #2 of family #1 from the snapshot
  \cs_new_protected:Npn \__msz_opt_restore:nn #1#2
    {
      \cs_if_exist:cTF { msz@snap@ #1 @flag }
        { \cs_set_eq:cc { msz@ #1 @ #2 } { msz@snap@ #1 @ #2 } }
        { \msg_error:nnn { math-shorthandz } { reset-outside } { #1 } }
    }

  % sets option #2 of family #1 to the value #3, or restores it if it is \zreset
  \cs_new_protected:Npn \msz@opt@set #1#2#3
    {
      \tl_if_eq:nnTF {#3} { \zreset }
        { \__msz_opt_restore:nn {#1} {#2} }
        { \cs_set:cpn { msz@ #1 @ #2 } { #3 } }
    }

  % opens the group of one call of a command with options and applies in it
  % the keys of the alias that called it, if any. Outermost alias call of a
  % family: first snapshots its options. The command closes the group with
  % \group_end:, which adds no atom, so spacing and class are those of the output.
  \cs_new_protected:Npn \__msz_begin:
    {
      \group_begin:
      \tl_if_empty:NF \g__msz_alias_tl
        {
          \tl_set_eq:NN \l_tmpa_tl \g__msz_alias_tl
          \tl_set_eq:NN \l_tmpb_tl \g__msz_alias_fam_tl
          \tl_gclear:N \g__msz_alias_tl
          \cs_if_exist:cF { msz@snap@ \l_tmpb_tl @flag }
            { \__msz_snap:n { \l_tmpb_tl } }
          \exp_args:NnV \setkeys { shorthand } \l_tmpa_tl
        }
    }

\ExplSyntaxOff

% ==============================================================================
% \zpunct {punct}
% ------------------------------------------------------------------------------
% Punctuation at the right end of a display line, before the equation number
% (numbered rows) or flush right through \tag* (starred environments).
% Discarded in \notag/\nonumber rows.
% ==============================================================================

  \newcommand{\msz@currentpunct}{}
  \def\tagform@#1{%
    \maketag@@@{\msz@currentpunct(\ignorespaces#1\unskip\@@italiccorr)}%
    \gdef\msz@currentpunct{}%
  }
  \let\msz@make@display@tag\make@display@tag
  \def\make@display@tag{%
    \if@eqnsw\else\iftag@\else\gdef\msz@currentpunct{}\fi\fi
    \msz@make@display@tag
  }
  \NewDocumentCommand \zpunct { m }
    {
      \ifst@rred
        \tag*{#1}%
      \else
        \gdef\msz@currentpunct{#1\space}%
      \fi
    }

% ==============================================================================
% \zline [count] {symbol}   |   \zvec {symbol}   |   \zmat {symbol}
% ------------------------------------------------------------------------------
% <count> rules under the symbol; \zvec and \zmat are the one- and two-rule
% wrappers. All three use the `zline-` keys.
% ==============================================================================

  \msz@opt{line}{depth}{depth}{2pt}
  \msz@opt{line}{thickness}{thickness}{0.4pt}
  \msz@opt{line}{separation}{separation}{0.9pt}

\ExplSyntaxOn

  \box_new:N \l__msz_line_box
  \dim_new:N \l__msz_line_depth_dim
  \dim_new:N \l__msz_line_thickness_dim
  \dim_new:N \l__msz_line_sep_dim

  \NewDocumentCommand \zline { O{1} m }
    {
      \leavevmode
      \__msz_begin:
      \dim_set:Nn \l__msz_line_depth_dim     { \msz@line@depth       }
      \dim_set:Nn \l__msz_line_thickness_dim { \msz@line@thickness   }
      \dim_set:Nn \l__msz_line_sep_dim       { \msz@line@separation  }
      \hbox_set:Nn \l__msz_line_box
        { \ensuremath{ \mathsurround=0pt #2 } }
      \vtop
        {
          \offinterlineskip
          \box_use:N \l__msz_line_box
          \kern \l__msz_line_depth_dim
          \int_step_inline:nn {#1}
            {
              \hrule
                height \l__msz_line_thickness_dim
                width  \box_wd:N \l__msz_line_box
              \int_compare:nNnF {##1} = {#1}
                { \kern \l__msz_line_sep_dim }
            }
        }
      \group_end:
    }

  \NewDocumentCommand \zvec { m } { \ensuremath { \zline[1]{#1} } }
  \NewDocumentCommand \zmat { m } { \ensuremath { \zline[2]{#1} } }

\ExplSyntaxOff

% ==============================================================================
% \zfrac * * [num] {num} [den] {den}
% ------------------------------------------------------------------------------
% {x} plain, [x] parenthesised; one argument is the denominator. No star:
% \frac; one star: \nicefrac; two stars: n/d. No options.
% ==============================================================================

\ExplSyntaxOn

  \tl_new:N   \l__msz_frac_num_tl
  \tl_new:N   \l__msz_frac_den_tl

  \bool_new:N \l__msz_frac_num_paren_bool
  \bool_new:N \l__msz_frac_den_paren_bool
  \bool_new:N \l__msz_frac_den_present_bool
  % NOTE: den_present is always true (see \__msz_frac_parse:nnnnnn), so the
  % "no denominator" branch of \__msz_frac_render:nn is dead code (see TODO).

  % wraps #1 in \left( \right); always called inside \ensuremath
  \cs_new:Npn \__msz_frac_paren:n #1
    { \left( #1 \right) }

  % renders operand #2, parenthesised when bool #1 is true
  \cs_new:Npn \__msz_frac_arg:Nn #1 #2
    {
      \bool_if:NTF #1
        { \__msz_frac_paren:n {#2} }
        {#2}
    }

  % typesets the fraction in the requested style — #1 star  #2 double star
  \cs_new:Npn \__msz_frac_render:nn #1 #2
    {
      \bool_if:NF \l__msz_frac_den_present_bool
        { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
        {
          \IfBooleanTF {#1}
            {
              \IfBooleanTF {#2}
                {
                  \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl }
                  /
                  \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl }
                }
                {
                  \nicefrac
                    { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
                    { \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl } }
                }
            }
            {
              \frac
                { \__msz_frac_arg:Nn \l__msz_frac_num_paren_bool { \l__msz_frac_num_tl } }
                { \__msz_frac_arg:Nn \l__msz_frac_den_paren_bool { \l__msz_frac_den_tl } }
            }
        }
    }

  % maps the o g o g arguments of \zfrac to the num/den token lists and their
  % paren-bools, for every {}/[] combination
  \cs_new_protected:Npn \__msz_frac_parse:nnnnnn #1 #2 #3 #4 #5 #6
    {
      \IfNoValueTF {#3}
        {
          \IfNoValueTF {#5}
            {
              \IfNoValueTF {#6}
                {
                  \tl_set:Nn \l__msz_frac_num_tl { 1 }
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#4}
                  \bool_set_false:N \l__msz_frac_den_paren_bool
                }
                {
                  \tl_set:Nn \l__msz_frac_num_tl {#4}
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#6}
                  \bool_set_false:N \l__msz_frac_den_paren_bool
                }
            }
            {
              \tl_set:Nn \l__msz_frac_num_tl {#4}
              \bool_set_false:N \l__msz_frac_num_paren_bool
              \bool_set_true:N  \l__msz_frac_den_present_bool
              \tl_set:Nn \l__msz_frac_den_tl {#5}
              \bool_set_true:N  \l__msz_frac_den_paren_bool
            }
        }
        {
          \IfNoValueTF {#4}
            {
              \IfNoValueTF {#5}
                {
                  \tl_set:Nn \l__msz_frac_num_tl { 1 }
                  \bool_set_false:N \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#3}
                  \bool_set_true:N  \l__msz_frac_den_paren_bool
                }
                {
                  \tl_set:Nn \l__msz_frac_num_tl {#3}
                  \bool_set_true:N  \l__msz_frac_num_paren_bool
                  \bool_set_true:N  \l__msz_frac_den_present_bool
                  \tl_set:Nn \l__msz_frac_den_tl {#5}
                  \bool_set_true:N  \l__msz_frac_den_paren_bool
                }
            }
            {
              \tl_set:Nn \l__msz_frac_num_tl {#3}
              \bool_set_true:N  \l__msz_frac_num_paren_bool
              \bool_set_true:N  \l__msz_frac_den_present_bool
              \tl_set:Nn \l__msz_frac_den_tl {#4}
              \bool_set_false:N \l__msz_frac_den_paren_bool
            }
        }
    }

  \NewDocumentCommand \zfrac { s s o g o g }
    {
      \__msz_frac_parse:nnnnnn {#1}{#2}{#3}{#4}{#5}{#6}
      \ensuremath{ \__msz_frac_render:nn {#1} {#2} }
    }

\ExplSyntaxOff

% ==============================================================================
% \zscale [factor] {math}
% ------------------------------------------------------------------------------
% Scales math content by <factor>, default `zscale-<style>` of the call.
% The helpers below are shared by every command that scales content; each
% passes its own option prefix (dot@scale, arg@scale, ...) and reads its own
% four factors and switch. Output: one \mathord box.
% ==============================================================================

  \msz@opt{scale}{display}{display}{1}
  \msz@opt{scale}{text}{text}{1}
  \msz@opt{scale}{script}{script}{0.7}
  \msz@opt{scale}{scriptscript}{scriptscript}{0.6}
  \msz@opt{scale}{absolute}{absolute}{true}

\ExplSyntaxOn

  \tl_new:N  \l__msz_scale_tl
  \tl_new:N  \l__msz_scale_name_tl
  \tl_new:N  \l__msz_scale_style_tl

  \dim_new:N \l__msz_scale_quad_dim

  % accumulated scale of the enclosing boxes, scale inside the box being
  % built, size of the style the content is set in, size of the call alone,
  % and size of a scriptscript call of the same command
  \fp_new:N  \l__msz_scale_acc_fp
  \fp_new:N  \l__msz_scale_new_fp
  \fp_new:N  \l__msz_scale_rset_fp
  \fp_new:N  \l__msz_scale_p_fp
  \fp_new:N  \l__msz_scale_g_fp
  \fp_set:Nn \l__msz_scale_acc_fp { 1 }

  % sets fp #1 to the size of style #2 relative to the text style (quad
  % ratio), using only scratch registers so the units stay untouched
  \cs_new_protected:Npn \__msz_rel:NN #1#2
    {
      \hbox_set:Nn \l__msz_unit_box { $ \m@th \textstyle \mkern 18mu $ }
      \dim_set:Nn \l__msz_scale_quad_dim { \box_wd:N \l__msz_unit_box }
      \hbox_set:Nn \l__msz_unit_box { $ \m@th #2 \mkern 18mu $ }
      \fp_set:Nn #1
        { \dim_to_fp:n { \box_wd:N \l__msz_unit_box } / \dim_to_fp:n { \l__msz_scale_quad_dim } }
    }

  % resolves the factor applied to the box (\l__msz_scale_tl), the style the
  % content is set in (\l__msz_scale_style_tl) and the scale inside the box
  % (\l__msz_scale_new_fp) — #1 factor (blank = option)  #2 option prefix
  % #3 style name  #4 ambient style. Physical size is max(acc*p, min(p, g)):
  % nesting may shrink a call down to g (scriptscript call), never below p.
  \cs_new_protected:Npn \__msz_scale_set:nnnN #1#2#3#4
    {
      \tl_set:Nx \l__msz_scale_name_tl {#3}
      \exp_args:Nv \str_if_eq:nnTF { msz@ #2 @absolute } { true }
        {
          \fp_set:Nn \l__msz_scale_rset_fp { 1 }
          \fp_set:Nn \l__msz_scale_g_fp { \use:c { msz@ #2 @scriptscript } }
          \str_if_eq:VnTF \l__msz_scale_name_tl { display }
            { \tl_set:Nn \l__msz_scale_style_tl { \displaystyle } }
            { \tl_set:Nn \l__msz_scale_style_tl { \textstyle } }
        }
        {
          \__msz_rel:NN \l__msz_scale_rset_fp #4
          \__msz_rel:NN \l__msz_scale_g_fp \scriptscriptstyle
          \fp_set:Nn \l__msz_scale_g_fp
            { \l__msz_scale_g_fp * \use:c { msz@ #2 @scriptscript } }
          \tl_set:Nn \l__msz_scale_style_tl {#4}
        }
      \tl_set:Nx \l__msz_scale_tl
        {
          \tl_if_blank:nTF {#1}
            { \use:c { msz@ #2 @ \l__msz_scale_name_tl } }
            {#1}
        }
      \fp_set:Nn \l__msz_scale_p_fp { \l__msz_scale_rset_fp * ( \l__msz_scale_tl ) }
      \fp_set:Nn \l__msz_scale_new_fp
        {
          max ( \l__msz_scale_acc_fp * \l__msz_scale_p_fp ,
                min ( \l__msz_scale_p_fp , \l__msz_scale_g_fp ) )
          / \l__msz_scale_rset_fp
        }
      \tl_set:Nx \l__msz_scale_tl
        { \fp_to_decimal:n { \l__msz_scale_new_fp / \l__msz_scale_acc_fp } }
    }

  % one \mathchoice branch — #1 factor (blank = option)  #2 math
  % #3 option prefix  #4 style name  #5 ambient style. Nested calls inside
  % the box see the new accumulated scale.
  \cs_new_protected:Npn \__msz_scale:nnnnN #1#2#3#4#5
    {
      \__msz_scale_set:nnnN {#1} {#3} {#4} #5
      \exp_args:NV \scalebox \l__msz_scale_tl
        {
          \fp_set_eq:NN \l__msz_scale_acc_fp \l__msz_scale_new_fp
          $ \m@th \l__msz_scale_style_tl #2 $
        }
    }

  \NewDocumentCommand \zscale { O{} m }
    {
      \__msz_begin:
      \ensuremath
        {
          \mathord
            {
              \mathchoice
                { \__msz_scale:nnnnN {#1} {#2} { scale } { display }      \displaystyle      }
                { \__msz_scale:nnnnN {#1} {#2} { scale } { text }         \textstyle         }
                { \__msz_scale:nnnnN {#1} {#2} { scale } { script }       \scriptstyle       }
                { \__msz_scale:nnnnN {#1} {#2} { scale } { scriptscript } \scriptscriptstyle }
            }
        }
      \group_end:
    }

\ExplSyntaxOff

% ==============================================================================
% \zdot
% ------------------------------------------------------------------------------
% Heavier \cdot (scaled by `zdot-scale-<style>`), kept on the math axis; \mathbin.
% ==============================================================================

