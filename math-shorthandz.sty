        {
          \bool_if:nTF {#1}
            {
              \__msz_scale:nnnnN { } {#2} { int@scale }
                { \l__msz_int_ctx_tl } #3
            }
            { $ \m@th #3 #2 $ }
        }
      \__msz_int_anchor:n {#4}
      \dim_set:Nn \l__msz_int_v_dim
        {
          \__msz_ratio:nN
            { \use:c { msz@int@ \l__msz_int_mode_tl @ \l__msz_int_cls_tl @ #4 @v } }
            \l__msz_unit_v_dim
        }
      \dim_set:Nn \l__msz_int_h_dim
        {
          \__msz_ratio:nN
            { \use:c { msz@int@ \l__msz_int_mode_tl @ \l__msz_int_cls_tl @ #4 @h } }
            \l__msz_unit_h_dim
        }
      \dim_set:Nn #6
        {
          \l__msz_int_cy_dim + \l__msz_int_v_dim
          \str_if_eq:nnTF {#4} { top } { + \box_dp:N #5 } { - \box_ht:N #5 }
        }
      \dim_set:Nn #7
        {
          \l__msz_int_ref_dim + \l__msz_int_h_dim
          - \fp_to_dim:n { \l__msz_int_anch_tl * \box_wd:N #5 }
        }
      \dim_set:Nn \l__msz_int_left_dim
        { \dim_max:nn { \l__msz_int_left_dim } { - #7 } }
      \dim_set:Nn \l__msz_int_right_dim
        {
          \dim_max:nn { \l__msz_int_right_dim }
            { #7 + \box_wd:N #5 - \box_wd:N \l__msz_int_glyph_box }
        }
    }

  % whole integral (one \mathchoice branch), used bare: \zint wraps it in
  % \mathop outside the \mathchoice — #1 lower star  #2 lower  #3 upper star
  % #4 upper  #5 type  #6 style name of the glyph  #7 style of the glyph
  % #8 style of the limits
  \cs_new_protected:Npn \__msz_int_build:nnnnnnNN #1#2#3#4#5#6#7#8
    {
      \tl_set:Nn \l__msz_int_type_tl {#5}
      \tl_if_blank:nT {#5} { \tl_set:Nn \l__msz_int_type_tl {1} }
      \tl_set:Nn \l__msz_int_ctx_tl {#6}
      \str_if_eq:nnTF {#6} { display }
        { \tl_set:Nn \l__msz_int_mode_tl { math } }
        { \tl_set:Nn \l__msz_int_mode_tl { text } }
      \__msz_unit:N #7
      \hbox_set:Nn \l__msz_int_glyph_box { $ \m@th #7 \__msz_int_cluster: $ }
      \hbox_set:Nn \l__msz_int_last_box { $ \m@th #7 \__msz_int_glyph: $ }
      \dim_set:Nn \l__msz_int_cy_dim
        { ( \box_ht:N \l__msz_int_glyph_box - \box_dp:N \l__msz_int_glyph_box ) / 2 }
      \dim_zero:N \l__msz_int_left_dim
      \dim_zero:N \l__msz_int_right_dim
      \tl_if_blank:nF {#2}
        {
          \__msz_int_limit:nnnnNNN {#1} {#2} {#8} { bottom }
            \l__msz_int_low_box \l__msz_int_lowr_dim \l__msz_int_lowx_dim
        }
      \tl_if_blank:nF {#4}
        {
          \__msz_int_limit:nnnnNNN {#3} {#4} {#8} { top }
            \l__msz_int_up_box \l__msz_int_upr_dim \l__msz_int_upx_dim
        }
      \hbox_set:Nn \l__msz_int_out_box
        {
          \kern \__msz_ratio:nN { \__msz_int_opt:n { before } } \l__msz_unit_h_dim
          \kern \l__msz_int_left_dim
          \tl_if_blank:nF {#2}
            {
              \rlap
                {
                  \kern \l__msz_int_lowx_dim
                  \box_move_up:nn { \l__msz_int_lowr_dim } { \box_use:N \l__msz_int_low_box }
                }
            }
          \tl_if_blank:nF {#4}
            {
              \rlap
                {
                  \kern \l__msz_int_upx_dim
                  \box_move_up:nn { \l__msz_int_upr_dim } { \box_use:N \l__msz_int_up_box }
                }
            }
          \box_use:N \l__msz_int_glyph_box
          \kern \l__msz_int_right_dim
          \kern \__msz_ratio:nN { \__msz_int_opt:n { after } } \l__msz_unit_h_dim
        }
      \box_set_ht:Nn \l__msz_int_out_box
        {
          \box_ht:N \l__msz_int_out_box
          + \__msz_ratio:nN { \__msz_int_opt:n { above } } \l__msz_unit_v_dim
        }
      \box_set_dp:Nn \l__msz_int_out_box
        {
          \box_dp:N \l__msz_int_out_box
          + \__msz_ratio:nN { \__msz_int_opt:n { below } } \l__msz_unit_v_dim
        }
      \box_use:N \l__msz_int_out_box
    }

  \NewDocumentCommand \zint { s O{} s O{} s s O{1} }
    {
      \__msz_begin:
      \bool_if:nTF {#5}
        {
          \bool_if:nTF {#6}
            { \tl_set:Nn \l__msz_int_cls_tl { right } }
            { \tl_set:Nn \l__msz_int_cls_tl { stack } }
        }
        { \tl_set:Nn \l__msz_int_cls_tl { slant } }
      \ensuremath
        {
          \mathop
            {
              \mathchoice
                { \__msz_int_build:nnnnnnNN {#1}{#2}{#3}{#4}{#7} { display }      \displaystyle      \scriptstyle       }
                { \__msz_int_build:nnnnnnNN {#1}{#2}{#3}{#4}{#7} { text }         \textstyle         \scriptstyle       }
                { \__msz_int_build:nnnnnnNN {#1}{#2}{#3}{#4}{#7} { script }       \scriptstyle       \scriptscriptstyle }
                { \__msz_int_build:nnnnnnNN {#1}{#2}{#3}{#4}{#7} { scriptscript } \scriptscriptstyle \scriptscriptstyle }
            }
          \nolimits
        }
      \group_end:
    }

\ExplSyntaxOff

% ==============================================================================
% \zalias {new} {base} {key=value,...}
% ------------------------------------------------------------------------------
% Defines <new> as a variant of <base> (a command with options, or an alias):
% same arguments, but the keys apply during each call. The prefix of the
% base's family is prepended to every key, so only its options can change;
% `reset` (key) and \zreset (value) restore options from the snapshot taken
% by the outermost enclosing alias call of the family.
%
% Registry: \msz@cmd@<command> holds the family of each package command
% (empty: no options). An alias <new> stores its root command in
% \msz@alias@cmd@<new> and its flattened, prefixed key list (the keys of its
% base first) in \msz@alias@keys@<new>. The alias macro hands the list and the
% family to \g__msz_alias_tl / \g__msz_alias_fam_tl and calls the root
% command, whose \__msz_begin: consumes them.
% ==============================================================================

\ExplSyntaxOn

  \tl_new:N \l__msz_alias_new_tl
  \tl_new:N \l__msz_alias_base_tl
  \tl_new:N \l__msz_alias_cmd_tl
  \tl_new:N \l__msz_alias_fam_tl
  \tl_new:N \l__msz_alias_prefix_tl
  \tl_new:N \l__msz_alias_keys_tl

  \tl_const:cn { msz@cmd@zline } { line }
  \tl_const:cn { msz@cmd@zvec  } { line }
  \tl_const:cn { msz@cmd@zmat  } { line }
  \clist_map_inline:nn { zscale, zdot, zarg, zdiff, zcond, zscript, zprime, zlim, zint }
    { \tl_const:cx { msz@cmd@ #1 } { \str_tail:n {#1} } }
  \clist_map_inline:nn { zpunct, zfrac, zalias, zreset }
    { \tl_const:cn { msz@cmd@ #1 } { } }

  \msg_new:nnn { math-shorthandz } { alias-new }
    {
      #1~is~a~command~of~the~package~or~an~existing~macro,~so~
      \c_backslash_str zalias~cannot~define~it.
    }
  \msg_new:nnn { math-shorthandz } { alias-base }
    {
      #1~is~neither~a~command~of~the~package~with~options~nor~an~alias~of~one,~
      so~\c_backslash_str zalias~cannot~be~based~on~it.
    }

  % keyval handlers: append key #1, or key #1 with value #2, to the key list,
  % with the prefix of the base family prepended
  \cs_new_protected:Npn \__msz_alias_key:n #1
    {
      \tl_put_right:Nx \l__msz_alias_keys_tl
        { \exp_not:V \l__msz_alias_prefix_tl \exp_not:n {#1} , }
    }
  \cs_new_protected:Npn \__msz_alias_pair:nn #1#2
    {
      \tl_put_right:Nx \l__msz_alias_keys_tl
        { \exp_not:V \l__msz_alias_prefix_tl \exp_not:n { #1 = {#2} , } }
    }

  % resolves the base (name in \l__msz_alias_base_tl) into its root command,
  % its family and the keys it already carries; the family stays empty when
  % the base cannot be aliased
  \cs_new_protected:Npn \__msz_alias_base:
    {
      \tl_clear:N \l__msz_alias_keys_tl
      \tl_clear:N \l__msz_alias_cmd_tl
      \tl_clear:N \l__msz_alias_fam_tl
      \cs_if_exist:cTF { msz@alias@cmd@ \l__msz_alias_base_tl }
        {
          \tl_set_eq:Nc \l__msz_alias_keys_tl { msz@alias@keys@ \l__msz_alias_base_tl }
          \tl_set_eq:Nc \l__msz_alias_cmd_tl  { msz@alias@cmd@ \l__msz_alias_base_tl }
        }
        { \tl_set_eq:NN \l__msz_alias_cmd_tl \l__msz_alias_base_tl }
      \cs_if_exist:cT { msz@cmd@ \l__msz_alias_cmd_tl }
        { \tl_set_eq:Nc \l__msz_alias_fam_tl { msz@cmd@ \l__msz_alias_cmd_tl } }
    }

  % defines alias #1 of base #2 with keys #3; the keys are validated once in
  % a throwaway group (with a snapshot, so that reset is accepted)
  \cs_new_protected:Npn \__msz_alias_define:NNn #1#2#3
    {
      \tl_set:Nx \l__msz_alias_new_tl  { \cs_to_str:N #1 }
      \tl_set:Nx \l__msz_alias_base_tl { \cs_to_str:N #2 }
      \bool_if:nTF
        {
          \cs_if_exist_p:c { msz@cmd@ \l__msz_alias_new_tl }
          ||
          (
            \cs_if_exist_p:N #1
            && ! \cs_if_exist_p:c { msz@alias@cmd@ \l__msz_alias_new_tl }
          )
        }
        { \msg_error:nnx { math-shorthandz } { alias-new } { \token_to_str:N #1 } }
        {
          \__msz_alias_base:
          \tl_if_empty:NTF \l__msz_alias_fam_tl
            { \msg_error:nnx { math-shorthandz } { alias-base } { \token_to_str:N #2 } }
            {
              \tl_set:Nx \l__msz_alias_prefix_tl { z \l__msz_alias_fam_tl - }
              \keyval_parse:NNn \__msz_alias_key:n \__msz_alias_pair:nn {#3}
              \group_begin:
                \__msz_snap:n { \l__msz_alias_fam_tl }
                \exp_args:NnV \setkeys { shorthand } \l__msz_alias_keys_tl
              \group_end:
              \cs_set:cpx { msz@alias@keys@ \l__msz_alias_new_tl }
                { \exp_not:V \l__msz_alias_keys_tl }
              \cs_set:cpx { msz@alias@cmd@ \l__msz_alias_new_tl }
                { \exp_not:V \l__msz_alias_cmd_tl }
              \cs_set_protected:Npx #1
                {
                  \exp_not:N \tl_gset:Nn \exp_not:N \g__msz_alias_tl
                    { \exp_not:V \l__msz_alias_keys_tl }
                  \exp_not:N \tl_gset:Nn \exp_not:N \g__msz_alias_fam_tl
                    { \exp_not:V \l__msz_alias_fam_tl }
                  \exp_not:c { \l__msz_alias_cmd_tl }
                }
            }
        }
    }

  \NewDocumentCommand \zalias { m m m }
    { \__msz_alias_define:NNn #1 #2 {#3} }

\ExplSyntaxOff

